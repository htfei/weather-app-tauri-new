{
  "$schema": "../schema.json",
  "identifier": "default",
  "description": "Default permissions for TingFM Radio",
  "version": "1.0.0",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:webview:default"
  ],
  "commands": {
    "allow": [
      "get_radio_catalog",
      "update_radio_catalog_from_url",
      "save_radio_catalog",
      "toggle_favorite",
      "get_favorites",
      "add_play_history",
      "proxy_stream_url"
    ]
  }
}
